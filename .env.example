# Copie este archivo a .env y elija UNA de las opciones. NUNCA suba .env a un repositorio.

# ---------- Opción A: modelo LOCAL con Ollama (sin clave, sin costo) ----------
# Instale Ollama (https://ollama.com) y ejecute:  ollama pull qwen2.5:7b
FINANZAS_PROVIDER=ollama
FINANZAS_MODEL=qwen2.5:7b

# ---------- Opción B: Google Gemini, capa gratuita (clave gratis en aistudio.google.com) ----------
# gemini-3.5-flash-lite: probado con el agente. gemini-3.8-flash solo permite 20 solicitudes/día en la capa gratuita.
# FINANZAS_PROVIDER=gemini
# FINANZAS_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY=pegue_aqui_su_clave

# ---------- Opción C: Groq, capa gratuita (clave gratis en console.groq.com) ----------
# FINANZAS_PROVIDER=groq
# FINANZAS_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=pegue_aqui_su_clave

# ---------- Opción D: Anthropic (clave de pago) ----------
# FINANZAS_PROVIDER=anthropic
# FINANZAS_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# Otro servicio compatible con la API de OpenAI:
# FINANZAS_PROVIDER=openai_compat
# FINANZAS_BASE_URL=https://.../v1

# Nivel de razonamiento (opcional; en Gemini el valor por defecto es low): none | low | medium | high
# FINANZAS_REASONING_EFFORT=low
FINANZAS_MAX_TOKENS=2048
FINANZAS_MAX_ITERATIONS=8
FINANZAS_CURRENCY=COP
# Archivo de datos (opcional). Use data/finanzas_demo.json para probar con datos ficticios.
# FINANZAS_DATA_PATH=data/finanzas.json
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
